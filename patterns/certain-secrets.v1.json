{
  "patterns_version": 1,
  "_notes": {
    "purpose": "Public certain-secret patterns (DET-02) and the shared stop-word lists (RUN-07a). One file, consumed unchanged by the server and by the app; neither side may add, remove or edit a pattern locally.",
    "policy": "Certain means precision first. A family enters this file only with a documented prefix or structure whose false-positive rate on ordinary text is negligible. Anything entropy- or label-based belongs to the suspected detector of the app, never here.",
    "regex_subset": "Every regex is written in the common subset of JavaScript RegExp with the 'u' flag and the Rust regex crate: no look-ahead, no look-behind, no back-references, no possessive quantifiers, no atomic groups, no named groups, no inline flags. Only literals, character classes, non-capturing groups, alternation and the greedy quantifiers ?, +, {n}, {n,}.",
    "word_boundaries": "\\b is deliberately absent. JavaScript in 'u' mode defines it over ASCII word characters, the Rust regex crate over Unicode word characters, so the same pattern would match differently on the two sides next to a non-ASCII character. No portable replacement exists without look-around, so boundaries are simply not asserted: a match may start inside a longer run of text, which is the safe direction for a redactor. The end of a match needs no boundary either, because every tail quantifier is greedy and therefore consumes the whole token.",
    "escapes": "Inside a character class the hyphen is written \\- so that it can never be read as a range. Outside a character class it is written bare: \\- is a SyntaxError in JavaScript 'u' mode.",
    "order": "Patterns are matched in file order and a match that overlaps an earlier one is dropped, so a value is reported once, under the most specific family. This is why anthropic_api_key precedes openai_api_key.",
    "kind": "kind is the coarse family reported in the outcome's secret_treated and stored in the log (TECHNICAL-DESIGN 4.6); id is the pattern that matched and stays internal. The vocabulary is exactly: private_key, api_key, token, webhook_secret, webhook_url, jwt.",
    "matched_text": "The matched text is never logged, stored or returned. Only kind and the location of the match travel.",
    "stop_words": "Used by the runbook matching rule (TECHNICAL-DESIGN 4.5.3): tokens shorter than three characters are already dropped by that rule, so the shorter Italian articles are kept only for completeness. All entries are lowercase, because the rule lowercases before comparing.",
    "fixtures": "fixtures/secrets/positive.txt must be matched line by line with recall 1.0; fixtures/secrets/negative.txt must produce zero matches. Both are part of the contract and are checked on the TypeScript side by test/contract/patterns.test.ts.",
    "deviation": "openai_api_key does not use the shape printed in TECHNICAL-DESIGN 4.6. See DEVIATIONS.md, entry T-006."
  },
  "patterns": [
    {
      "id": "private_key_block",
      "kind": "private_key",
      "regex": "-----BEGIN (?:[A-Z ]+ )?PRIVATE KEY-----",
      "description": "PEM private key header, with or without an algorithm word",
      "tests": {
        "match": [
          "-----BEGIN PRIVATE KEY-----",
          "-----BEGIN RSA PRIVATE KEY-----",
          "-----BEGIN EC PRIVATE KEY-----",
          "-----BEGIN OPENSSH PRIVATE KEY-----"
        ],
        "no_match": [
          "-----BEGIN CERTIFICATE-----",
          "-----BEGIN PUBLIC KEY-----",
          "----- BEGIN PRIVATE KEY -----",
          "-----begin rsa private key-----"
        ]
      }
    },
    {
      "id": "aws_access_key_id",
      "kind": "api_key",
      "regex": "(?:AKIA|ASIA)[0-9A-Z]{16}",
      "description": "AWS access key id, long-term (AKIA) or temporary (ASIA)",
      "tests": {
        "match": ["AKIAIOSFODNN7EXAMPLE", "ASIAZ3K7B2QY4XW9TFMD"],
        "no_match": [
          "AKIAIOSFODNN7EXAMPL",
          "akiaiosfodnn7example",
          "AKIA-IOSFODNN7EXAMPLE",
          "MEDIA_KIT_ASSETS_2026"
        ]
      }
    },
    {
      "id": "stripe_secret_key",
      "kind": "api_key",
      "regex": "[sr]k_(?:live|test)_[0-9A-Za-z]{16,}",
      "description": "Stripe secret or restricted key, live or test",
      "tests": {
        "match": [
          "sk_live_51QxMzPq7RtYuIoPaSdFgHjKl",
          "sk_test_51QxMzPq7RtYuIoPaSdFgHjKl",
          "rk_live_51QxMzPq7RtYuIoPaSdFgHjKl"
        ],
        "no_match": [
          "pk_live_51QxMzPq7RtYuIoPaSdFgHjKl",
          "sk_live_tooshort",
          "sk_prod_51QxMzPq7RtYuIoPaSdFgHjKl"
        ]
      }
    },
    {
      "id": "stripe_webhook_secret",
      "kind": "webhook_secret",
      "regex": "whsec_[0-9A-Za-z]{20,}",
      "description": "Stripe webhook signing secret",
      "tests": {
        "match": ["whsec_KpQ8vN2mR7tYxW4bZ1cD5eF9gH3jL6nM"],
        "no_match": ["whsec_short", "webhook_secret_is_not_set", "WHSEC_KpQ8vN2mR7tYxW4bZ1cD5eF9"]
      }
    },
    {
      "id": "github_token",
      "kind": "token",
      "regex": "(?:gh[pousr]_[0-9A-Za-z]{36,}|github_pat_[0-9A-Za-z_]{80,})",
      "description": "GitHub token: classic or app shapes (ghp_, gho_, ghu_, ghs_, ghr_) and fine-grained personal access token",
      "tests": {
        "match": [
          "ghp_A1b2C3d4E5f6G7h8I9j0KlMnOpQrStUvWxYz",
          "ghs_A1b2C3d4E5f6G7h8I9j0KlMnOpQrStUvWxYz",
          "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"
        ],
        "no_match": [
          "ghp_tooshort",
          "ghz_A1b2C3d4E5f6G7h8I9j0KlMnOpQrStUvWxYz",
          "github_pat_A1b2C3d4E5f6G7h8I9j0KlMnOpQrStUvWxYz",
          "github_pages_deployment_workflow"
        ]
      }
    },
    {
      "id": "slack_token",
      "kind": "token",
      "regex": "xox[abprs]-[0-9A-Za-z\\-]{10,}",
      "description": "Slack API token: bot, app, user, refresh or legacy shape",
      "tests": {
        "match": [
          "xoxb-2451234567890-2451234567891-AbCdEfGhIjKlMnOpQrStUvWx",
          "xoxp-1234567890-1234567890-1234567890-abc123def456"
        ],
        "no_match": ["xoxb-short", "xoxo-1234567890abcdef", "xoxb_2451234567890_abcdefghij"]
      }
    },
    {
      "id": "slack_webhook_url",
      "kind": "webhook_url",
      "regex": "https://hooks\\.slack\\.com/services/T[0-9A-Z]+/B[0-9A-Z]+/[0-9A-Za-z]+",
      "description": "Slack incoming webhook URL, which grants posting rights on its own",
      "tests": {
        "match": [
          "https://hooks.slack.com/services/T02AB3CD4EF/B05GH6IJ7KL/9mNoPqRsTuVwXyZ0123456"
        ],
        "no_match": [
          "https://hooks.slack.com/services/",
          "https://api.slack.com/messaging/webhooks",
          "https://hooks.slack.com/services/T02AB3CD4EF/B05GH6IJ7KL/"
        ]
      }
    },
    {
      "id": "google_api_key",
      "kind": "api_key",
      "regex": "AIza[0-9A-Za-z_\\-]{35}",
      "description": "Google API key",
      "tests": {
        "match": ["AIzaSyB1qW3eR5tY7uI9oP2aS4dF6gH8jK0lZxC"],
        "no_match": [
          "AIzaSyB1qW3eR5tY7uI9oP2aS4dF6gH8jK0lZx",
          "AIZASYB1QW3ER5TY7UI9OP2AS4DF6GH8JK0LZXC"
        ]
      }
    },
    {
      "id": "anthropic_api_key",
      "kind": "api_key",
      "regex": "sk-ant-[0-9A-Za-z_\\-]{20,}",
      "description": "Anthropic API key. Listed before openai_api_key so that the more specific prefix wins",
      "tests": {
        "match": ["sk-ant-api03-A1b2C3d4E5f6G7h8I9j0KlMnOpQrStUvWxYz"],
        "no_match": ["sk-ant-short", "sk_ant_api03_A1b2C3d4E5f6G7h8I9j0KlMnOpQrSt"]
      }
    },
    {
      "id": "openai_api_key",
      "kind": "api_key",
      "regex": "sk-(?:proj-[0-9A-Za-z_\\-]{20,}|[0-9A-Za-z]{20,})",
      "description": "OpenAI API key: project key (sk-proj-) or the older flat shape, whose tail is alphanumeric only so that hyphenated words ending in sk- are not matched",
      "tests": {
        "match": [
          "sk-A1b2C3d4E5f6G7h8I9j0KlMnOpQrStUvWxYz1234567890",
          "sk-proj-A1b2C3d4E5f6G7h8I9j0KlMnOpQrStUvWxYz_-1234567890abcdefgh"
        ],
        "no_match": [
          "sk-tooshort",
          "risk-assessment-and-mitigation-2026",
          "task-runner-configuration-page",
          "the disk-usage-report-generator-service"
        ]
      }
    },
    {
      "id": "gitlab_pat",
      "kind": "token",
      "regex": "glpat-[0-9A-Za-z_\\-]{20}",
      "description": "GitLab personal access token",
      "tests": {
        "match": ["glpat-A1b2C3d4E5f6G7h8I9j0"],
        "no_match": ["glpat-short", "glpat_A1b2C3d4E5f6G7h8I9j0"]
      }
    },
    {
      "id": "npm_token",
      "kind": "token",
      "regex": "npm_[0-9A-Za-z]{36}",
      "description": "npm automation or publish token",
      "tests": {
        "match": ["npm_3aZ9kQ2wE7rT4yU8iO1pA6sD5fG0hJ2lXcVb"],
        "no_match": ["npm_install", "npm_3aZ9kQ2wE7rT4yU8iO1pA6sD5fG0hJ2l"]
      }
    },
    {
      "id": "sendgrid_api_key",
      "kind": "api_key",
      "regex": "SG\\.[0-9A-Za-z_\\-]{22}\\.[0-9A-Za-z_\\-]{43}",
      "description": "SendGrid API key, prefix plus two fixed-length segments",
      "tests": {
        "match": ["SG.A1b2C3d4E5f6G7h8I9j0Kl.MnOpQrStUvWxYz0123456789AbCdEfGhIjKlMnOpQrS"],
        "no_match": ["SG.short.short", "SG.A1b2C3d4E5f6G7h8I9j0Kl.MnOpQrStUvWxYz0123456789"]
      }
    },
    {
      "id": "huggingface_token",
      "kind": "token",
      "regex": "hf_[0-9A-Za-z]{34}",
      "description": "Hugging Face access token. The 34-character tail is what keeps our own hf_ handoff ids, which carry ten characters, out of this family",
      "tests": {
        "match": ["hf_QzWxEcRvTyBnUmIoLpAsDfGhJkZxCv3456"],
        "no_match": ["hf_7k2m9x4b3n", "hf_abc", "hf_QzWxEcRvTyBnUmIoLpAsDfGhJkZxCv34-6"]
      }
    },
    {
      "id": "digitalocean_token",
      "kind": "token",
      "regex": "dop_v1_[0-9a-f]{64}",
      "description": "DigitalOcean personal access token",
      "tests": {
        "match": ["dop_v1_9f8e7d6c5b4a39281706f5e4d3c2b1a09f8e7d6c5b4a39281706f5e4d3c2b1a0"],
        "no_match": [
          "dop_v1_9f8e7d6c5b4a39281706f5e4d3c2b1a0",
          "dop_v1_9F8E7D6C5B4A39281706F5E4D3C2B1A09F8E7D6C5B4A39281706F5E4D3C2B1A0"
        ]
      }
    },
    {
      "id": "jwt",
      "kind": "jwt",
      "regex": "eyJ[0-9A-Za-z_\\-]{10,}\\.eyJ[0-9A-Za-z_\\-]{10,}\\.[0-9A-Za-z_\\-]{10,}",
      "description": "JSON Web Token: two base64url segments that start with a JSON object, plus a signature",
      "tests": {
        "match": [
          "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IlJlbmRlciBUZXN0In0.dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk"
        ],
        "no_match": [
          "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIn0",
          "eyJhbGciOiJIUzI1NiJ9.payload.signature"
        ]
      }
    }
  ],
